  "components": {
    "schemas": {
      "cardAccessResult": {
        "type": "object",
        "description": "Ответ метода проверки данных ПМ",
        "additionalProperties": false,
        "required": [
          "isAllowed"
        ],
        "properties": {
          "isAllowed": {
            "type": "boolean",
            "description": "Признак того, что сотрудник и клиент находятся в одной точке продаж",
            "example": false
          }
        }
      },
      "SofkErrorDto": {
        "type": "object",
        "description": "Ошибки при выполнении запроса",
        "additionalProperties": false,
        "properties": {
          "time": {
            "type": "string",
            "format": "date-time",
            "description": "Время ответа",
            "pattern": "^[0-9]{4}-((0[1-9])|(1[0-2]))-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}(()|(.[0-9]{1,6})(Z|([+-](0[0-9]|1[0-2]):([0-5][0-9])))|(.[0-9]{1,6}))|)$"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 2147483647,
            "description": "Код ответа"
          },
          "error": {
            "type": "string",
            "maxLength": 255,
            "description": "Причина ошибки"
          },
          "message": {
            "type": "string",
            "maxLength": 255,
            "description": "Сообщение ошибки"
          },
          "path": {
            "type": "string",
            "description": "URN ответа",
            "maxLength": 100,
            "example": "/employee/by-login/12342123"
          }
        }
      },
      "ClientServiceTeamRequestParams": {
        "type": "object",
        "description": "Входные параметры для запроса команды обслуживания клиента",
        "additionalProperties": false,
        "required": [
          "mdmId",
          "needActualization"
        ],
        "properties": {
          "mdmId": {
            "type": "string",
            "description": "mdmId клиента",
            "maxLength": 19
          },
          "needActualization": {
            "type": "boolean",
            "description": "Признак необходимости актуализации ПУ клиента и его КО в 1503 Продуктовый профиль ФЛ"
          }
        }
      },
      "ClientCardAccessRequestParams": {
        "type": "object",
        "description": "Входные параметры для предоставления безверификационного доступа",
        "additionalProperties": false,
        "required": [
          "operationId"
        ],
        "properties": {
          "operationId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9223372036854775807
          }
        }
      },
      "ServiceTeamResponseParams": {
        "type": "object",
        "description": "Запись о клиенте Прайм",
        "required": [
          "customer",
          "servicePack",
          "isVip",
          "isTop",
          "isExOb",
          "isSuperVip",
          "team",
          "serviceGroup"
        ],
        "additionalProperties": false,
        "properties": {
          "customer": {
            "$ref": "#/components/schemas/Customer"
          },
          "servicePack": {
            "$ref": "#/components/schemas/ServicePack"
          },
          "isVip": {
            "type": "boolean",
            "description": "Метка VIP"
          },
          "isTop": {
            "type": "boolean",
            "description": "Метка TOP"
          },
          "team": {
            "type": "array",
            "description": "Команда обслуживания",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/TeamMember"
            }
          },
          "serviceGroup": {
            "$ref": "#/components/schemas/ServiceGroup"
          },
          "tempAgreementExpirationDate": {
            "type": "string",
            "description": "Дата окончания временного соглашения",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "isExOb": {
            "type": "boolean",
            "description": "Метка Открытие.Брокер"
          },
          "isSuperVip": {
            "type": "boolean",
            "description": "Наличие метки SuperVip"
          },
          "company": {
            "type": "string",
            "description": "Название организации",
            "maxLength": 255
          }
        }
      },
      "Customer": {
        "type": "object",
        "description": "Описание одного клиента",
        "additionalProperties": false,
        "required": [
          "mdmId",
          "lastName",
          "firstName",
          "middleName"
        ],
        "properties": {
          "mdmId": {
            "type": "string",
            "maxLength": 19
          },
          "lastName": {
            "type": "string",
            "maxLength": 50
          },
