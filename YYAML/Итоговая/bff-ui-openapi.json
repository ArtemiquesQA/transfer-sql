    "/int/client/card/access/{mdmId}": {
      "get": {
        "description": "Проверить наличие безверификационного доступа к клиенту",
        "operationId": "check_unverified_card_access",
        "tags": [
          "client-controller"
        ],
        "parameters": [
          {
            "name": "mdmId",
            "in": "path",
            "required": true,
            "description": "mdm_id клиента для проверки наличия доступа безверификации",
            "schema": {
              "type": "string",
              "maxLength": 19
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Результат проверки",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/cardAccessResult"
                }
              }
            }
          },
          "400": {
            "description": "Ошибка валидации",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SofkErrorDto"
                }
              }
            }
          },
          "404": {
            "description": "Клиент не найден",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SofkErrorDto"
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка сервера",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SofkErrorDto"
                }
              }
            }
          }
        }
      }
    },
